{
  "configurations": [
    {
      "name": "opengema-aarch64-uefi",
      "compilerPath": "/usr/bin/clang++",
      "compilerArgs": [
        "--target=aarch64-unknown-windows",
        "-ffreestanding",
        "-nostdinc",
        "-fshort-wchar",
        "-mno-red-zone",
        "-fno-exceptions",
        "-fno-rtti",
        "-std=c++20"
      ],
      "includePath": [
        "${workspaceFolder}/libs/cxx",
        "${workspaceFolder}/libs/efi",
        "${workspaceFolder}/kernel/include"
      ],
      "defines": [],
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "linux-clang-arm64",
      "browse": {
        "path": [
          "${workspaceFolder}/libs/cxx",
          "${workspaceFolder}/libs/efi",
          "${workspaceFolder}/kernel"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4
}
